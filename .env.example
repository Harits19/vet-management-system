# ============================================================
# Template env. Dua file saja di project ini:
#   - .env.example  → template (nilai dev, komentar untuk prod)
#   - .env          → dipakai produksi (di server; JANGAN di-commit)
#
# Dev laptop: TIDAK perlu membuat .env — `docker compose up -d mongodb`
# + `npm run dev` jalan dengan default di bawah ini.
#
# Produksi: `cp .env.example .env`, sesuaikan nilai prod (lihat komentar
# "# prod:"), lalu `docker compose up -d`.
# ============================================================

# --- MongoDB ---
# MONGO_PORT: 127.0.0.1:27017 = hanya localhost (dev) | 0.0.0.0:27017 = publik (prod)
MONGO_PORT=127.0.0.1:27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=dev-root-password
MONGO_APP_USERNAME=vetapp
MONGO_APP_PASSWORD=dev-app-password

# --- Backend ---
NODE_ENV=development            # prod: production
PORT=3001
MONGODB_URI=mongodb://vetapp:dev-app-password@localhost:27017/vet-management?authSource=vet-management
JWT_SECRET=dev-secret-change-me # prod: ganti dengan string acak kuat
JWT_EXPIRES_IN=7d
DEFAULT_USER_PASSWORD=password123
ENABLE_SEED=true
COOKIE_SECURE=false             # prod: true
FRONTEND_ORIGINS=http://localhost:3002   # prod: https://wedi-animal-care.ahlabs.my.id

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001   # prod: https://wedi-animal-care.ahlabs.my.id
