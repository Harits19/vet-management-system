# ============================================================
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# dipakai oleh docker-compose (interpolasi ${VAR}) dan backend
# (apps/backend/src/config/env.ts membaca .env di mode production,
#  .env.example di mode development).
# ============================================================

# --- MongoDB (auth) ---
# User root mongo (dibuat otomatis oleh image mongo dari env ini,
# hanya pada volume yang masih kosong)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change-me-root

# User aplikasi untuk koneksi backend (dibuat oleh ./mongo-init.js
# pada volume baru; untuk volume lama buat manual, lihat README)
MONGO_APP_USERNAME=vetapp
MONGO_APP_PASSWORD=change-me-app

# --- Backend ---
NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb://vetapp:change-me-app@localhost:27017/vet-management?authSource=vet-management
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
DEFAULT_USER_PASSWORD=password123
ENABLE_SEED=true
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3002

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Nginx / Production (hanya dipakai docker-compose.prod.yml) ---
# FRONTEND_ORIGINS=https://wedi-animal-care.ahlabs.my.id
# NEXT_PUBLIC_API_URL=https://wedi-animal-care.ahlabs.my.id
# COOKIE_SECURE=true
