{
  "name": "vet-management-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:full": "concurrently -k -n next,api -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "build": "next build",
    "build:full": "npm run build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "start:server": "node server/dist/server/src/server.js",
    "start:full": "concurrently -k -n next,api -c blue,green \"npm run start\" \"npm run start:server\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@typegoose/typegoose": "^13.2.1",
    "bcrypt": "^5.1.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jose": "^6.2.2",
    "mongoose": "^9.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
