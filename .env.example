# ============================================================
# Template .env — struktur MENGIKUTI .env produksi di server.
#   - .env          → dipakai SEMUA mode (dev & produksi); JANGAN di-commit
#   - .env.example  → template ini
#
# Setup: cp .env.example .env, sesuaikan nilainya, lalu:
#   dev  : npm run dev            (backend & predev baca .env ini)
#   prod : docker compose up -d   (compose baca .env ini)
# ============================================================

# ── MongoDB ─────────────────────────────────────────────────
# MONGO_PORT hanya dipakai docker compose (bind port container → host).
# 127.0.0.1:27017 = localhost saja (dev) | 0.0.0.0:27017 = publik (prod)
MONGO_PORT=127.0.0.1:27017

# Root user mongo: dibuat otomatis oleh image mongo di volume baru,
# dipakai mongo-init.js untuk connect & membuat user aplikasi.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=dev-root-password

# User aplikasi: dibuat mongo-init.js (idempotent). URI mongo di-generate
# di kode dari key ini + MONGODB_HOST (tidak ada key MONGODB_URI).
MONGO_APP_USERNAME=vetapp
MONGO_APP_PASSWORD=dev-app-password

# Host mongo untuk koneksi native (npm run dev / predev mongo-init.js).
#   dev           : localhost
#   laptop→server : 43.157.243.138
#   docker        : otomatis "mongodb" (service name, di-set compose,
#                   MONGODB_HOST di .env TIDAK dipakai docker)
MONGODB_HOST=localhost

# ── Backend ─────────────────────────────────────────────────
NODE_ENV=development            # prod: production
PORT=3001
JWT_SECRET=dev-secret-change-me # prod: ganti dengan string acak kuat
JWT_EXPIRES_IN=7d
DEFAULT_USER_PASSWORD=password123
ENABLE_SEED=true
COOKIE_SECURE=false             # prod: true
FRONTEND_ORIGINS=http://localhost:3002   # prod: https://wedi-animal-care.ahlabs.my.id

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001   # prod: https://wedi-animal-care.ahlabs.my.id

# ── Store / Klinik (kop surat & rekam medis) ────────────────
# Dipakai backend → frontend mengambil via GET /api/config/store
# CATATAN: nilai berisi spasi WAJIB dikutip (deploy.sh me-source .env)
STORE_NAME="Wedi Animal Care"
STORE_ADDRESS="Jl. Raya Sel. No.42, Dusun II, Gadungan, Kec. Wedi, Kabupaten Klaten, Jawa Tengah 57461"
STORE_WHATSAPP="0859-6615-8397"
STORE_PHONE=

# ── Absensi wajah & lokasi ───────────────────────────────────
# Titik lokasi kantor (lat/lng). KOSONG = validasi lokasi dimatikan (absen cukup wajah).
# Isi keduanya untuk mengaktifkan absensi berbasis lokasi (wajib di dalam radius).
# Contoh koordinat Klaten: OFFICE_LAT=-7.7529 OFFICE_LNG=110.6064
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_METERS=200
# Ambang kecocokan wajah (jarak euclidean, face-api default 0.6; makin kecil makin ketat)
ATTENDANCE_FACE_THRESHOLD=0.6
